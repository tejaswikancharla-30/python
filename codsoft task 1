from PyQt5 import QtCore, QtWidgets
class Ui_Form(object):
    def setupUi(self, Form):
        Form.setObjectName("Calculator")
        Form.resize(395, 575)
        Form.setStyleSheet("background-color:black;")

        # Display Label
        self.label = QtWidgets.QLabel(Form)
        self.label.setGeometry(QtCore.QRect(20, 20, 350, 70))
        self.label.setStyleSheet("""
            color:white;
            background-color:rgb(15,15,15);
            border-radius:10px;
            padding:10px;
            font: 28pt "Bahnschrift SemiLight Condensed";
        """)
        self.label.setAlignment(QtCore.Qt.AlignRight)
        self.label.setText("")

        # Button Style
        style = """
            QPushButton{
                background-color:rgb(25,25,25);
                color:white;
                border-radius:10px;
                font: 18pt "Bahnschrift SemiLight Condensed";
            }
            QPushButton:hover{
                background-color:rgb(45,45,45);
            }
        """

        # Buttons
        self.buttons = {}

        btn_texts = [
            ('7', 30, 120), ('8', 120, 120), ('9', 210, 120), ('/', 300, 120),
            ('4', 30, 210), ('5', 120, 210), ('6', 210, 210), ('*', 300, 210),
            ('1', 30, 300), ('2', 120, 300), ('3', 210, 300), ('-', 300, 300),
            ('0', 30, 390), ('.', 120, 390), ('=', 210, 390), ('+', 300, 390),
            ('AC', 30, 480), ('Back', 210, 480)
        ]

        for text, x, y in btn_texts:
            button = QtWidgets.QPushButton(Form)
            button.setGeometry(QtCore.QRect(x, y, 75, 71))
            button.setText(text)
            button.setStyleSheet(style)
            self.buttons[text] = button

        # Large Back Button
        self.buttons['Back'].setGeometry(QtCore.QRect(120, 480, 165, 71))

        # Connections
        self.buttons['0'].clicked.connect(lambda: self.write_number("0"))
        self.buttons['1'].clicked.connect(lambda: self.write_number("1"))
        self.buttons['2'].clicked.connect(lambda: self.write_number("2"))
        self.buttons['3'].clicked.connect(lambda: self.write_number("3"))
        self.buttons['4'].clicked.connect(lambda: self.write_number("4"))
        self.buttons['5'].clicked.connect(lambda: self.write_number("5"))
        self.buttons['6'].clicked.connect(lambda: self.write_number("6"))
        self.buttons['7'].clicked.connect(lambda: self.write_number("7"))
        self.buttons['8'].clicked.connect(lambda: self.write_number("8"))
        self.buttons['9'].clicked.connect(lambda: self.write_number("9"))

        self.buttons['+'].clicked.connect(lambda: self.write_number("+"))
        self.buttons['-'].clicked.connect(lambda: self.write_number("-"))
        self.buttons['*'].clicked.connect(lambda: self.write_number("*"))
        self.buttons['/'].clicked.connect(lambda: self.write_number("/"))
        self.buttons['.'].clicked.connect(lambda: self.write_number("."))

        self.buttons['='].clicked.connect(self.calculate)
        self.buttons['AC'].clicked.connect(self.clear)
        self.buttons['Back'].clicked.connect(self.backspace)

        QtCore.QMetaObject.connectSlotsByName(Form)

    # Write Numbers
    def write_number(self, value):
        current = self.label.text()
        self.label.setText(current + value)

    # Calculate Result
    def calculate(self):
        try:
            result = str(eval(self.label.text()))
            self.label.setText(result)
        except:
            self.label.setText("Error")

    # Clear Screen
    def clear(self):
        self.label.setText("")

    # Backspace
    def backspace(self):
        text = self.label.text()
        self.label.setText(text[:-1])


if __name__ == "__main__":
    import sys

    app = QtWidgets.QApplication(sys.argv)
    Form = QtWidgets.QWidget()

    ui = Ui_Form()
    ui.setupUi(Form)

    Form.show()
    sys.exit(app.exec_())
